# Server-only key: enable "Places API (New)". Restrict by API, never expose to the browser.
GOOGLE_MAPS_API_KEY=

# Browser key: enable "Maps JavaScript API" and restrict by HTTP referrer. Map is hidden if unset.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# Optional Cloud map ID for Advanced Markers (defaults to DEMO_MAP_ID).
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
